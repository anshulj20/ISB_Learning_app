# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local-first data — never belongs in git, even a private repo. Code is
# backed up here; the actual archive (DB + uploaded files) is backed up
# separately per PROJECT_SPEC.md's Storage & backup strategy.
/prisma/dev.db
/prisma/dev.db-journal
*.db
*.db-journal
/files/

# eLearn scraper — persistent login session (real session cookies, must
# never leave this machine) and ad-hoc debug screenshots.
/.playwright-profile/
scripts/elearn/debug-*.png

